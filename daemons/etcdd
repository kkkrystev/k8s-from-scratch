#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

source "$PROJECT_ROOT/lib/validate.sh"
source "$PROJECT_ROOT/lib/storage/store.sh"
source "$PROJECT_ROOT/lib/storage/service.sh"

export LC_ALL=C
export ETCD_DIR="${ETCD_DIR:-/var/lib/k8s-from-scratch/etcd-server}"
export ETCD_READ_TIMEOUT="${ETCD_READ_TIMEOUT:-3}"

listener_pid=''

server_check_config() {
    if [[ "$ETCD_DIR" != /* ]]; then
        echo 'ETCD_DIR must be an absolute path.' >&2
        return 1
    fi

    if ! validate_positive_integer "$ETCD_READ_TIMEOUT"; then
        echo 'ETCD_READ_TIMEOUT must be a positive integer.' >&2
        return 1
    fi
}

server_handle_request() {
    local request

    # The parent passes both the open descriptor and its number.
    if [[ ! "${ETCD_LOCK_FD:-}" =~ ^[0-9]+$ ]]; then
        return 1
    fi

    flock -n "$ETCD_LOCK_FD" 2>/dev/null || return 1

    if ! IFS= read -r -t "$ETCD_READ_TIMEOUT" -n 65537 request; then
        store_error incomplete_request
    elif ((${#request} > 65536)); then
        store_error request_too_large
    else
        store_dispatch "$request"
    fi
}

server_check_listener() {
    local bind="$1"
    local port="$2"
    local command

    if [[ ! "$bind" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo 'ETCD_BIND must be an IPv4 address.' >&2
        return 1
    fi

    if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]]; then
        echo 'ETCD_PORT must be an integer from 1 to 65535.' >&2
        return 1
    fi

    if ((port > 65535)); then
        echo 'ETCD_PORT must be an integer from 1 to 65535.' >&2
        return 1
    fi

    for command in jq socat flock setpriv; do
        if ! command -v "$command" >/dev/null; then
            echo "Missing: $command" >&2
            return 1
        fi
    done
}

server_prepare_storage() {
    local existing

    umask 077
    mkdir -p -- "$ETCD_DIR" || return 1

    exec {ETCD_LOCK_FD}>"$ETCD_DIR/server.lock" || return 1
    export ETCD_LOCK_FD

    if ! flock -n "$ETCD_LOCK_FD"; then
        echo 'Storage already in use.' >&2
        return 1
    fi

    if [[ ! -e "$ETCD_DIR/state.json" ]]; then
        existing=$(find "$ETCD_DIR" -mindepth 1 \
            ! -name server.lock -print -quit) || return 1

        if [[ -n "$existing" ]]; then
            echo 'Use a fresh ETCD_DIR for this storage format.' >&2
            return 1
        fi

        store_commit '{"version":1,"keys":{}}' || return 1
    fi

    if ! store_load >/dev/null; then
        echo 'Invalid storage; data retained.' >&2
        return 1
    fi
}

server_cleanup() {
    trap - EXIT INT TERM

    if [[ -n "$listener_pid" ]]; then
        kill -TERM "$listener_pid" 2>/dev/null || true
        wait "$listener_pid" 2>/dev/null || true
        listener_pid=''
    fi
}

server_listen() {
    local bind="$1"
    local port="$2"
    local result

    cd -- "$SCRIPT_DIR" || return 1

    printf 'Storage listener starting on %s:%s\n' "$bind" "$port" >&2

    while true; do
        # One connection is handled before the next listener is started.
        setpriv --pdeathsig TERM \
            socat \
            "TCP4-LISTEN:$port,bind=$bind,reuseaddr" \
            'EXEC:bash ./etcdd --handle,nofork' &

        listener_pid=$!

        if wait "$listener_pid"; then
            listener_pid=''
        else
            result=$?
            listener_pid=''
            return "$result"
        fi
    done
}

main() {
    local bind="${ETCD_BIND:-127.0.0.1}"
    local port="${ETCD_PORT:-2379}"

    server_check_config || return 1

    if [[ $# -eq 1 && "$1" == --handle ]]; then
        server_handle_request
        return $?
    fi

    if [[ $# -ne 0 ]]; then
        echo "Usage: $0 (configured by ETCD_DIR, ETCD_BIND, ETCD_PORT)" >&2
        return 1
    fi

    server_check_listener "$bind" "$port" || return 1
    server_prepare_storage || return 1

    trap server_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    server_listen "$bind" "$port"
}

main "$@"
