#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

NODE_NAME="${NODE_NAME:-}"
ETCD_ENDPOINT="${ETCD_ENDPOINT:-127.0.0.1:2379}"
POD_STATE_DIR="${POD_STATE_DIR:-/var/lib/k8s-from-scratch/pods}"
NAMESPACE_DIR="${NAMESPACE_DIR:-/run/k8s-from-scratch}"
KUBELET_LOG="${KUBELET_LOG:-$PROJECT_ROOT/logs/kubelet.log}"
RECONCILE_INTERVAL="${RECONCILE_INTERVAL:-5}"

NETWORK_SOCKET="${NETWORK_SOCKET:-/run/k8s-from-scratch/network.sock}"

export POD_STATE_DIR NAMESPACE_DIR NETWORK_SOCKET

source "$PROJECT_ROOT/lib/runtime/client.sh"

source "$PROJECT_ROOT/lib/storage/client.sh"
source "$PROJECT_ROOT/lib/json.sh"
source "$PROJECT_ROOT/lib/validate.sh"
source "$PROJECT_ROOT/lib/network/client.sh"

log() {
    printf '[%s] [kubelet] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "$KUBELET_LOG"
}

launch_pod() {
    local pod_name="$1"
    local spec="$2"

    local args_file
    local args=()
    local pod_ip config prefix gateway
    local started_at
    local status_json
    local runtime_json
    local state
    local reported_ip

    local uid
    uid=$(jq -er .uid <<< "$spec") || return 1
    local log_path="$POD_STATE_DIR/$pod_name/log"

    # Decode first, checking for errors before reading the NUL-separated arguments.
    args_file=$(mktemp) || return 1

    if ! json_get_container_command "$spec" > "$args_file"; then
        rm -f -- "$args_file"
        return 1
    fi

    if ! mapfile -d '' -t args < "$args_file"; then
        rm -f -- "$args_file"
        return 1
    fi

    rm -f -- "$args_file" || return 1

    # json_build_status arguments:
    # state, started_at, exited_at, exit_code, log, pod_ip.
    # Literal null means that this observation supplies no value for the field.
    if ! config=$(network_reserve "$pod_name"); then
        status_json=$(json_build_status \
            unknown null null null "$log_path" null
        ) || return 1

        etcd_status_pod "$pod_name" "$uid" "$status_json" || return 1
        return 1
    fi

    pod_ip=$(jq -er '.ip | select(type == "string")' <<< "$config") || return 1
    prefix=$(jq -er '.prefix | select(type == "number")' <<< "$config") || return 1
    gateway=$(jq -er '.gateway | select(type == "string")' <<< "$config") || return 1

    started_at=$(date +%s) || return 1

    status_json=$(json_build_status \
        starting "$started_at" null null "$log_path" null
    ) || return 1

    etcd_status_pod "$pod_name" "$uid" "$status_json" || return 1

    # Keep the reservation on failure so the next attempt can reuse the same IP.
    if ! runtime_json=$(
        runtime_start "$pod_name" "$pod_ip" "$prefix" "$gateway" \
            -- "${args[@]}" 2>> "$KUBELET_LOG"
    ); then
        status_json=$(json_build_status \
            unknown null null null "$log_path" null
        ) || return 1

        etcd_status_pod "$pod_name" "$uid" "$status_json" || return 1
        return 1
    fi

    etcd_status_pod "$pod_name" "$uid" "$runtime_json" || return 1

    state=$(json_get_field "$runtime_json" state) || return 1
    reported_ip=$(json_get_field "$runtime_json" pod_ip) || return 1

    log "Pod '$pod_name': $state, ip=$reported_ip."
}

reconcile_pod() {
    local name="$1" spec actual status state result pod_ip uid deleting node
    validate_name "$name" || return 1

    spec=$(etcd_get_optional "pods/$name/spec") || return 1
    [[ -n "$spec" ]] || return 0

    node=$(jq -r '
        (if has("node_name") then .node_name else "" end)
        | if type == "string" then
            .
          else
            error("node_name must be a string")
          end
    ' <<< "$spec") || return 1

    # Unassigned Pods wait for the scheduler; foreign Pods belong to another kubelet.
    [[ -n "$node" ]] || return 0
    [[ "$node" == "$NODE_NAME" ]] || return 0

    uid=$(jq -er '.uid' <<< "$spec") || return 1
    deleting=$(etcd_get_optional "pods/$name/deleting") || return 1

    if [[ -n "$deleting" ]]; then
        runtime_stop "$name" >> "$KUBELET_LOG" 2>&1 || return 1
        network_release "$name" >> "$KUBELET_LOG" 2>&1 || return 1
        status=$(etcd_get_optional "pods/$name/status") || return 1
        state=$(json_get_field "$status" state) || return 1

        if [[ "$state" != terminated ]]; then
            result=$(json_build_status terminated null "$(date +%s)" null null) || return 1
            etcd_status_pod "$name" "$uid" "$result" || return 1
            log "Pod '$name' terminated."
        fi

        return 0
    fi

    if ! actual=$(runtime_status "$name"); then
        result=$(json_build_status unknown null null null "$POD_STATE_DIR/$name/log") || return 1
        etcd_status_pod "$name" "$uid" "$result" || return 1

        return 1
    fi

    if [[ "$actual" == running ]]; then
        status=$(etcd_get_optional "pods/$name/status") || return 1
        state=$(json_get_field "$status" state) || return 1

        if [[ "$state" != running ]]; then

            # Read actual IP from live netns rather than stale status.
            pod_ip=$(runtime_ip "$name") || return 1
            result=$(json_build_status running null null null "$POD_STATE_DIR/$name/log" "${pod_ip:-null}") || return 1
            etcd_status_pod "$name" "$uid" "$result" || return 1
        fi
    elif [[ "$actual" == exited ]]; then
        launch_pod "$name" "$spec" || return 1
    else
        log "Unexpected runtime state: $actual"

        return 1
    fi
}

reconcile_once() {
    local names name

    names=$(etcd_pod_names) || return 1
    [[ -n "$names" ]] || return 0

    while IFS= read -r name; do

        if ! reconcile_pod "$name"; then
            log "Reconciliation failed for '$name'; will retry."
        fi
    done <<< "$names"
}

main() {
    # One kubelet per local Node, independent of the shared storage directory.
    validate_name "$NODE_NAME" || { echo 'Set NODE_NAME explicitly.' >&2; exit 1; }
    mkdir -p /run/k8s-from-scratch
    exec 7>/run/k8s-from-scratch/kubelet.lock
    flock -n 7 || { echo 'Kubelet already running on this Node.' >&2; exit 1; }
    mkdir -p -- "$(dirname -- "$KUBELET_LOG")"
    etcd_health >/dev/null || exit 1
    runtime_health >/dev/null || { echo "Runtime daemon is not ready." >&2; exit 1; }

    log "Starting node=$NODE_NAME endpoint=$ETCD_ENDPOINT. Reconcile interval: ${RECONCILE_INTERVAL}s"

    while true; do
        if ! reconcile_once; then
            log 'Cannot list pods; will retry.'
        fi

        sleep "$RECONCILE_INTERVAL"
    done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
