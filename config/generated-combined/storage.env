ETCD_BIND=0.0.0.0
ETCD_DIR=/var/lib/k8s-from-scratch/etcd-server
ETCD_ENDPOINT=kfs-etcd:2379
ETCD_PORT=2379
IPAM_SOCKET=/tmp/kfs-network/ipam.sock
IPAM_STATE=/var/lib/kfs-network-demo/ipam.json
LOG_DIR=/var/log/kfs
NAMESPACE_DIR=/run/kfs-network-demo
NETWORK_SOCKET=/tmp/kfs-network/network.sock
NET_BRIDGE=kfsdemo0
NET_ROUTES={"10.245.1.0/24":"172.29.240.11","10.245.2.0/24":"172.29.240.12"}
NODE_IP=172.29.240.2
NODE_NAME=storage
POD_STATE_DIR=/var/lib/kfs-runtime-demo/pods
POD_SUBNET=10.245.3.0/24
ROOTFS=/var/lib/k8s-from-scratch/rootfs
RUN_ETCD=true
RUN_WORKER=true
