#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

source "$PROJECT_ROOT/lib/node/config.sh"
source "$PROJECT_ROOT/lib/node/snapshot.sh"
source "$PROJECT_ROOT/lib/node/process.sh"
source "$PROJECT_ROOT/lib/node/service.sh"

STATE=/run/kfs-node-manager
STARTED=()
SERVICES=()
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
SNAPSHOT=''

rollback() {
    local i

    trap - EXIT INT TERM

    if ((${#STARTED[@]})); then
        echo 'Rolling back services started by this invocation...' >&2

        for ((i = ${#STARTED[@]} - 1; i >= 0; i--)); do
            node_stop_service "${STARTED[i]}" || break
        done
    fi
}

# Acquire the single manager lock and load any saved snapshot. All three
# actions run under this lock so only one node command manages services.
node_begin() {
    local self_stat cmd

    [[ $EUID == 0 ]] || {
        echo 'Run as root inside the Ubuntu Node.' >&2
        return 1
    }

    for cmd in jq flock nohup; do
        command -v "$cmd" >/dev/null || return 1
    done

    IFS= read -r self_stat < /proc/self/stat
    [[ ${self_stat%% *} == "$$" ]] || {
        echo 'PID namespace and /proc disagree; refusing to manage processes.' >&2
        return 1
    }

    umask 077
    mkdir -p -- "$STATE"

    exec 200>"$STATE/manager.lock"
    flock -n 200 || {
        echo 'Another node command is in progress.' >&2
        return 1
    }

    node_snapshot_load || return 1
}

# Reject a config path that disagrees with the saved snapshot, so status/stop
# always act on the services actually running.
node_check_saved_path() {
    if [[ $# == 1 && $(realpath -m -- "$1") != $(jq -r .source <<< "$SNAPSHOT") ]]; then
        echo 'Config path differs from the saved configuration; use node status/stop without a path.' >&2
        return 1
    fi
}

node_status() {
    local service failed=0

    if [[ -z "$SNAPSHOT" ]]; then
        echo 'No managed services. Manually started services are not managed here.'
        return 0
    fi

    node_check_saved_path "$@" || return 1

    node_services

    printf 'Saved configuration: %s\n' "$(jq -r .source <<< "$SNAPSHOT")"

    for service in "${SERVICES[@]}"; do
        if ! node_alive "$service"; then
            echo "$service: stopped"
            failed=1
            continue
        fi

        if ! node_health "$service"; then
            echo "$service: running, unhealthy"
            failed=1
            continue
        fi

        if [[ "$service" == kubelet || "$service" == scheduler ]]; then
            printf '%s: running (PID %s; no health RPC)\n' "$service" "$(node_pid "$service")"
        else
            printf '%s: running, healthy (PID %s)\n' "$service" "$(node_pid "$service")"
        fi
    done

    return "$failed"
}

node_stop() {
    local i

    if [[ -z "$SNAPSHOT" ]]; then
        echo 'No managed services. Manually started services are not managed here.'
        return 0
    fi

    node_check_saved_path "$@" || return 1

    node_services

    for ((i = ${#SERVICES[@]} - 1; i >= 0; i--)); do
        node_stop_service "${SERVICES[i]}" || return 1
    done

    echo 'Services stopped. Pods, network resources and persistent data retained.'
}

node_start() {
    local config candidate active=0 service

    [[ $# == 1 ]] || {
        echo 'start requires a config path.' >&2
        return 1
    }

    config=$(node_config "$1") || return 1

    candidate=$(node_snapshot_candidate "$(realpath -- "$1")" "$PROJECT_ROOT" "$config")

    for service in ipamd networkd runtimed kubelet etcdd scheduler; do
        node_alive "$service" && active=1
    done

    if ((active)) && node_snapshot_differs "$SNAPSHOT" "$candidate"; then
        echo 'Configuration changed while services run. Use node stop, then node start.' >&2
        return 1
    fi

    SNAPSHOT="$candidate"
    node_services

    node_preflight || {
        echo 'Preflight failed; no services started.' >&2
        return 1
    }

    node_snapshot_save "$SNAPSHOT" || return 1

    trap rollback EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    for service in "${SERVICES[@]}"; do
        if node_alive "$service"; then
            node_health "$service" || {
                echo "$service is running but unhealthy; no automatic restart." >&2
                return 1
            }

            echo "$service: already running"
        else
            rm -f -- "$STATE/$service.go"
            node_launch "$service" || return 1
        fi
    done

    STARTED=()
    trap - EXIT INT TERM

    echo 'Services ready. You can leave this shell; services continue in the background.'
}

main() {
    local action

    [[ $# -ge 1 && $# -le 2 ]] || {
        echo "Usage: $0 start <config.env> | status [config.env] | stop [config.env]" >&2
        return 1
    }

    action="$1"
    shift

    case "$action" in
        start|status|stop) ;;
        *) return 1 ;;
    esac

    node_begin || return 1

    case "$action" in
        start)  node_start "$@" ;;
        status) node_status "$@" ;;
        stop)   node_stop "$@" ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
