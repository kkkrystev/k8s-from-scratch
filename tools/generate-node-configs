#!/bin/bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 cluster.json [output-directory]" >&2
    exit 1
fi

input="$1"
output="${2:-config/generated}"

# Validate the complete topology before writing any configuration files.
cluster=$(jq -cse '
    def name:
        type == "string"
        and length <= 63
        and test("^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$");

    def ip:
        type == "string"
        and (
            split(".") as $p
            | ($p | length) == 4
            and all($p[];
                test("^(0|[1-9][0-9]{0,2})$")
                and tonumber <= 255
            )
        );

    def subnet:
        type == "string"
        and endswith(".0/24")
        and (split("/")[0] | ip);

    def path:
        type == "string"
        and startswith("/")
        and test("^[^\\s]+$");

    select(length == 1)
    | .[0]
    | select(keys == ["defaults", "storage", "workers"]
        or keys == ["defaults", "scheduler", "storage", "workers"])
    | select(
        if has("scheduler") then
            .scheduler | type == "object"
            and keys == ["interval", "name"]
            and (.name | name)
            and (.interval | type == "string" and test("^[1-9][0-9]*$"))
        else true end
    )

    | select(.storage |
        keys == ["bind", "dir", "endpoint", "name", "port"]
        and (.name | name)
        and (.bind | ip)
        and (.dir | path)
        and (
            .endpoint
            | type == "string"
            and test("^[a-zA-Z0-9][a-zA-Z0-9.-]*:[1-9][0-9]{0,4}$")
        )
        and (
            .port
            | type == "string"
            and test("^[1-9][0-9]{0,4}$")
            and tonumber <= 65535
        )
    )

    | select((.storage.endpoint | split(":")[-1]) == .storage.port)

    | select(.defaults |
        type == "object"
        and all(.[];
            type == "string"
            and (explode | all(.[]; . != 0 and . != 10 and . != 13))
        )
    )

    | select(.workers |
        type == "array"
        and length > 0
        and all(.[];
            keys == ["ip", "name", "subnet"]
            and (.name | name)
            and (.ip | ip)
            and (.subnet | subnet)
        )
    )

    # The storage name may also identify one worker.
    | select(
        ([.workers[].name] | length)
        == ([.workers[].name] | unique | length)
    )
    | select(
        ([.workers[].ip] | length)
        == ([.workers[].ip] | unique | length)
    )
    | select(
        ([.workers[].subnet] | length)
        == ([.workers[].subnet] | unique | length)
    )
    | select(
        . as $c
        | all(.workers[];
            .ip as $ip
            | all($c.workers[];
                (.subnet | split(".")[0:3])
                != ($ip | split(".")[0:3])
            )
        )
    )
' "$input") || {
    echo 'Invalid topology: check fields, unique worker names/IPs/subnets and overlapping Node IPs.' >&2
    exit 1
}

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/lib/node-config.sh"

mkdir -p -- "$output"
tmp=$(mktemp -d "$output/.generate.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT

# Generate each Node once, including Nodes with both responsibilities.
while IFS= read -r name; do
    config=$(jq -c --arg name "$name" '
        . as $c
        | ([.workers[] | select(.name == $name)][0]) as $worker
        | (.storage.name == $name) as $storage
        | (.scheduler.name == $name) as $scheduler

        | $c.defaults + {
            NODE_NAME: $name,
            ETCD_ENDPOINT: $c.storage.endpoint,
            RUN_ETCD: ($storage | tostring),
            RUN_SCHEDULER: ($scheduler | tostring),
            SCHEDULER_NODES: ([$c.workers[].name] | tojson),
            SCHEDULER_INTERVAL: ($c.scheduler.interval // "2"),
            RUN_WORKER: (($worker != null) | tostring)
        }

        | if $worker != null then
            . + {
                NODE_IP: $worker.ip,
                POD_SUBNET: $worker.subnet,
                NET_ROUTES: (
                    [
                        $c.workers[]
                        | select(.name != $name)
                        | {key: .subnet, value: .ip}
                    ]
                    | from_entries
                    | tojson
                )
            }
        else
            .
        end

        | if $storage then
            . + {
                ETCD_BIND: $c.storage.bind,
                ETCD_PORT: $c.storage.port,
                ETCD_DIR: $c.storage.dir
            }
        else
            .
        end
    ' <<< "$cluster")

    jq -r '
        to_entries
        | sort_by(.key)[]
        | "\(.key)=\(.value)"
    ' <<< "$config" > "$tmp/$name.env"

    node_config "$tmp/$name.env" > /dev/null
done < <(jq -r '[.workers[].name, .storage.name, (.scheduler.name // empty)] | unique[]' <<< "$cluster")

# Refuse to overwrite differing files. Review changes in a new directory.
for file in "$tmp"/*.env; do
    dest="$output/${file##*/}"

    if [[ -e "$dest" || -L "$dest" ]]; then
        if ! cmp -s -- "$file" "$dest"; then
            echo "Different file exists: $dest. Generate into a new directory and review the diff." >&2
            exit 1
        fi
    fi
done

for file in "$tmp"/*.env; do
    dest="$output/${file##*/}"

    if [[ ! -e "$dest" ]]; then
        mv -- "$file" "$dest"
        chmod 644 "$dest"
    fi

    printf '%s\n' "$dest"
done
