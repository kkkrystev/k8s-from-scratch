#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/node-config.sh"
source "$SCRIPT_DIR/lib/node-process.sh"
STATE=/run/kfs-node-manager
STARTED=()
SERVICES=()
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
SNAPSHOT=''
rollback() {
    local i
    trap - EXIT INT TERM
    if ((${#STARTED[@]})); then
        echo 'Rolling back services started by this invocation...' >&2
        for ((i=${#STARTED[@]}-1;i>=0;i--)); do
            node_stop_service "${STARTED[i]}" || break
        done
    fi
}
main() {
    [[ $# -ge 1 && $# -le 2 ]] || { echo "Usage: $0 start <config.env> | status [config.env] | stop [config.env]" >&2; return 1; }
    local action="$1" config candidate active=0 service i failed=0 self_stat
    case "$action" in start|status|stop) ;; *) return 1 ;; esac
    [[ $EUID == 0 ]] || { echo 'Run as root inside the Ubuntu Node.' >&2; return 1; }
    for cmd in jq flock nohup; do command -v "$cmd" >/dev/null || return 1; done
    IFS= read -r self_stat < /proc/self/stat
    [[ ${self_stat%% *} == "$$" ]] || {
        echo 'PID namespace and /proc disagree; refusing to manage processes.' >&2; return 1;
    }
    umask 077
    mkdir -p -- "$STATE"
    exec 200>"$STATE/manager.lock"
    flock -n 200 || { echo 'Another node command is in progress.' >&2; return 1; }
    if [[ -f "$STATE/config.json" ]]; then
        SNAPSHOT=$(jq -ce 'select(.env|type=="object")' "$STATE/config.json") || return 1
    fi
    if [[ "$action" != start ]]; then
        [[ -n "$SNAPSHOT" ]] || { echo 'No managed services. Manually started services are not managed here.'; return 0; }
        if [[ $# == 2 && $(realpath -m -- "$2") != $(jq -r .source <<< "$SNAPSHOT") ]]; then
            echo 'Config path differs from the saved configuration; use node status/stop without a path.' >&2; return 1
        fi
        node_services
        if [[ "$action" == status ]]; then
            printf 'Saved configuration: %s\n' "$(jq -r .source <<< "$SNAPSHOT")"
            for service in "${SERVICES[@]}"; do
                if node_alive "$service"; then
                    if node_health "$service"; then
                        if [[ "$service" == kubelet ]]; then
                            printf '%s: running (PID %s; no health RPC)\n' "$service" "$(node_pid "$service")"
                        else
                            printf '%s: running, healthy (PID %s)\n' "$service" "$(node_pid "$service")"
                        fi
                    else echo "$service: running, unhealthy"; failed=1; fi
                else echo "$service: stopped"; failed=1; fi
            done
            return "$failed"
        fi
        for ((i=${#SERVICES[@]}-1;i>=0;i--)); do node_stop_service "${SERVICES[i]}" || return 1; done
        echo 'Services stopped. Pods, network resources and persistent data retained.'
        return 0
    fi
    [[ $# == 2 ]] || { echo 'start requires a config path.' >&2; return 1; }
    config=$(node_config "$2") || return 1
    candidate=$(jq -cnS --arg source "$(realpath -- "$2")" --arg project "$SCRIPT_DIR" --argjson env "$config" \
        '{source:$source,project:$project,env:$env}')
    for service in ipamd networkd kubelet etcdd; do node_alive "$service" && active=1; done
    if ((active)) && [[ $(jq -cS . <<< "$SNAPSHOT") != "$candidate" ]]; then
        echo 'Configuration changed while services run. Use node stop, then node start.' >&2; return 1
    fi
    SNAPSHOT="$candidate"
    node_services
    node_preflight || { echo 'Preflight failed; no services started.' >&2; return 1; }
    printf '%s\n' "$SNAPSHOT" > "$STATE/config.json.tmp"
    mv -- "$STATE/config.json.tmp" "$STATE/config.json"
    trap rollback EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    for service in "${SERVICES[@]}"; do
        if node_alive "$service"; then
            node_health "$service" || { echo "$service is running but unhealthy; no automatic restart." >&2; return 1; }
            echo "$service: already running"
        else
            rm -f -- "$STATE/$service.go"
            node_launch "$service" || return 1
        fi
    done
    STARTED=()
    trap - EXIT INT TERM
    echo 'Services ready. You can leave this shell; services continue in the background.'
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
